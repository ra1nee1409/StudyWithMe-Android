<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="268dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="1.5dp"
    app:rippleColor="@color/accent_cyan_subtle"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top profile row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivTutorAvatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@color/surface_container_high"
                    android:contentDescription="@string/section_tutors_title"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    app:shapeAppearanceOverlay="@style/RoundedAvatar12" />

                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle_shape"
                    android:backgroundTint="@color/status_success"
                    android:elevation="2dp">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/white" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTutorName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="ThS. Lê Hoàng Yến" />

                <TextView
                    android:id="@+id/tvTutorSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp"
                    tools:text="ĐH Sư Phạm Hà Nội" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/status_warning" />

                    <TextView
                        android:id="@+id/tvTutorRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="4.98" />

                    <TextView
                        android:id="@+id/tvTutorReviewCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/outline"
                        android:textSize="11sp"
                        tools:text="(142)" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Subject tags -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTagPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_chip"
                android:backgroundTint="@color/accent_cyan_subtle"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Toán nâng cao" />

            <TextView
                android:id="@+id/tvTagSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_chip"
                android:backgroundTint="@color/surface_container"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:maxWidth="148dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Luyện thi 9 lên 10" />
        </LinearLayout>

        <!-- Tuition row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_tuition"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTutorPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/tertiary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="160.000đ" />

            <TextView
                android:id="@+id/tvPriceUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_per_session"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Book trial CTA -->
        <TextView
            android:id="@+id/btnBookTrial"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_orange_cta"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/cta_book_trial"
            android:textColor="@color/on_tertiary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
